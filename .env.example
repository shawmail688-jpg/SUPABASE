# Supabase 凭证模板（CR-001：新式 key 命名，2026-09-14 批准）
# 用法：复制本文件为 .env 后填入真实值。.env / .env.* 已被 .gitignore 排除，永不提交、永不进对话。

# Dashboard → Project Settings → API
SUPABASE_URL=https://jfggeudssomocwcnpawk.supabase.co
# Publishable key（前端可见，非密钥，RLS 才是闸）
SUPABASE_PUBLISHABLE_KEY=
# Secret key（仅本机/服务端脚本，永不进前端产物）
SUPABASE_SECRET_KEY=

# Dashboard → Account → Access Tokens → Personal access token
# （Management API 用：DDL/迁移执行、day-1 建表；泄露=项目全权，用完可撤销）
SUPABASE_ACCESS_TOKEN=

# 数据库直连串（TASK-016 备份/psql 用；Dashboard → Settings → Database）
SUPABASE_DB_URL=
